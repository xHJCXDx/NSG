POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=osint_db

N8N_BASIC_AUTH_USER=change-me
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

DATABASE_URL=postgresql://change-me:change-me@localhost:5432/osint_db
# Must be at least 32 characters for HMAC-SHA256 security.
JWT_SECRET_KEY=change-me-to-a-strong-secret-at-least-32-chars

# Bootstrap-only compatibility credentials for the first admin login.
# They authenticate only while the system_users table is empty; once any
# DB user exists, authentication is DB-backed and these values are ignored.
# After first login, create a persistent DB admin through POST /api/users.
# Use strong non-default values in local/dev and never commit real secrets.
ADMIN_USER=change-me
ADMIN_PASSWORD=change-me
N8N_INTERNAL_URL=http://n8n:5678

# Internal Bearer token required by the Sentiment API /analyze endpoint.
# n8n must send this value as Authorization: Bearer <token>.
SENTIMENT_API_TOKEN=change-me

# Appsmith demo placeholders. Configure real values only in your local Appsmith
# runtime or private secret store; do not commit exported datasource credentials.
APPSMITH_PORT=8081
APPSMITH_DB_USER=appsmith_readonly
APPSMITH_DB_PASSWORD=change-me
APPSMITH_API_BEARER_TOKEN=change-me
N8N_WEBHOOK_HEADER=change-me
N8N_WEBHOOK_TOKEN=change-me

# Comma-separated list of allowed CORS origins for the backend API.
# Default (dev): http://localhost:5173,http://localhost:3000,http://localhost
# For production/staging, set to your actual domain(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
