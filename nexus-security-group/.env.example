POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=osint_db

N8N_BASIC_AUTH_USER=change-me
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

DATABASE_URL=postgresql://change-me:change-me@localhost:5432/osint_db
JWT_SECRET_KEY=change-me

# Bootstrap-only compatibility credentials for the first admin login.
# They authenticate only while the system_users table is empty; once any
# DB user exists, authentication is DB-backed and these values are ignored.
# After first login, create a persistent DB admin through POST /api/users.
# Use strong non-default values in local/dev and never commit real secrets.
ADMIN_USER=change-me
ADMIN_PASSWORD=change-me
N8N_INTERNAL_URL=http://n8n:5678
